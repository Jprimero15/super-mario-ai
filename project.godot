; Maryou AI - Godot 4.7.2
config_version=5

[application]
boot_splash/show_image=false
config/name="Maryou AI"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]
ScoreManager="*res://scripts/score_manager.gd"
AudioManager="*res://scripts/audio_manager.gd"
GameState="*res://scripts/game_state.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=4

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.6118, 0.8431, 0.7529, 1)
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/default_filter=0
textures/vram_compression/import_etc2_astc=true

[physics]
common/enable_pause_aware_picking=true

[input]
jump={"deadzone":0.4,"events":[Object(InputEventKey,"physical_keycode":32)]}
pause={"deadzone":0.4,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
